// Copier en Secrets.xcconfig et remplir avec l'identifiant OAuth iOS créé dans Google Cloud.
// Le "//" d'une URL serait lu comme un commentaire : ces valeurs n'en contiennent pas.
GOOGLE_CLIENT_ID = 000000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-xxxxxxxx

// Webhook Home Assistant de la vigie (automatisation « Relance : enregistrer un appareil »).
// Écrire « https:/$()/ » au lieu de « https:// » : sinon xcconfig prend la suite pour un commentaire.
RELANCE_WEBHOOK_URL = https:/$()/hooks.nabu.casa/XXXXXXXX
